# Google Apps Script Standalone Configuration
# Copie este arquivo para '.env.local' e preencha com seus valores

# URL do Google Apps Script standalone
# Obtida após fazer deploy no Apps Script
# Formato: https://script.google.com/macros/s/YOUR_SCRIPT_ID/usercopy
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/1ABC123XYZ456def789/usercopy
# Exemplo: 'abc123xyz789'
VITE_GOOGLE_SCRIPT_TOKEN=seu-token-secreto-aqui
